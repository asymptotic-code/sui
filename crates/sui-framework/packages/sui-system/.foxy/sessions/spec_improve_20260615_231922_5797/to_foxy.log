fun fungible_staked_sui_pool_id_spec(
    fungible_staked_sui: &FungibleStakedSui,
): ID {
    let result = staking_pool::fungible_staked_sui_pool_id(fungible_staked_sui);
    ensures(result == fungible_staked_sui.pool_id());
    result
}

