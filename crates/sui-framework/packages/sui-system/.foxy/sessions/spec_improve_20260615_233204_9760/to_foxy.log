// @VERIFY(⚙️/✅)
#[spec(prove, target=staking_pool::is_preactive)]
fun is_preactive_spec(
    pool: &StakingPool,
): bool {
    let result = staking_pool::is_preactive(pool);
    ensures(result == staking_pool::activation_epoch(pool).is_none());
    result
}

